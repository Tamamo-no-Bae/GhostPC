# the prototype itself (your own copy; never committed)
/game/
# build output, test captures, reverse-engineering dumps, local tools
/build/
/test/
/re/
/tools/
# compiled levels (shipped in the release zip, not the source) and a local SDK copy
/levels/zoo/out/
/levels/arena/out/
/levels/zoo/sdk/
# release staging: only the patch's text files are tracked; the zips go to GitHub Releases, and the patch's game
# files (Strings, Misc, Sounds, UI images) stay local
/release/*
!/release/GhostPC_Patch/
/release/GhostPC_Patch/*
!/release/GhostPC_Patch/GhostPC_README.txt
!/release/GhostPC_Patch/mapsrc/
/release/GhostPC_Patch/mapsrc/*
!/release/GhostPC_Patch/mapsrc/README.txt
!/release/GhostPC_Patch/mapsrc/compile_zoo.bat
!/release/GhostPC_Patch/mapsrc/arena/
/release/GhostPC_Patch/mapsrc/arena/*
!/release/GhostPC_Patch/mapsrc/arena/README.txt
!/release/GhostPC_Patch/mapsrc/arena/compile_arena.bat
# logs, dumps, caches
*.log
*.dmp
__pycache__/
*.pyc
# texture exports (game art; local only)
/exports/
# reskin sources (painted from game textures; local only)
/skins/
