// The Szlachta (testEnemy_old's szlachta.nod, converted from Vampire: The Masquerade - Redemption's demo by
// scripts/convert_redemption_nod.py): its two materials, as Redemption's .nam files (masked; the _dbl one twosided)
SzlachtaCombo
{
	shader masked
	meshType 7
	texture SzlachtaCombo
	sound creep
}

SzlachtaCombo_dbl
{
	shader masked
	meshType 7
	texture SzlachtaCombo
	twosided
	sound creep
}

NovaIce_hot
{
; Echo's head marked hot in sight mode (NovaReduxFinal_hot on her texture; novaVulture_echo.nod, make_echo_vulture.py)
	shader normal
	meshType 7
	texture NovaIce
	sightForceHot
	sound creep
}
